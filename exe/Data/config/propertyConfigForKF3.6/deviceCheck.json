    ],
    "SerialName": [],
    "SerialBaudRate": [
        {
            "validator":"enumeration",
            "secondParam":"param",
            "message":"仅支持1200, 2400, 4800, 9600, 19200, 28800, 38400, 76800, 115200"
        }
    ],
    "SerialParity": [
        {
            "validator":"enumeration",
            "secondParam":"param",
            "message":"仅支持0, 1, 2, 3, 4"
        }
    ],
    "SerialDataBits": [
        {
            "validator":"enumeration",
